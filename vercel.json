
{
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "echo \"$VERCEL_GIT_COMMIT_REF\" | grep -q '^dependabot/' && exit 0 || exit 1",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
